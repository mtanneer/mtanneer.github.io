---
import { buildSiteGraph } from '../lib/graph';

const graph = await buildSiteGraph();
---

<div class="site-graph mb-8 overflow-hidden rounded-md border border-[var(--border)] bg-[var(--bg-card)]">
  <svg
    id="site-graph-svg"
    viewBox="0 0 600 320"
    class="w-full touch-none"
    role="img"
    aria-label="Interactive graph of site pages, projects, and links"
  ></svg>
  <script type="application/json" id="site-graph-data" set:html={JSON.stringify(graph)} />
</div>

<script>
  import { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide } from 'd3-force';

  function initSiteGraph() {
    const svg = document.getElementById('site-graph-svg');
    if (!svg || svg.dataset.mounted) return;
    svg.dataset.mounted = 'true';

    const dataEl = document.getElementById('site-graph-data');
    const graphData = JSON.parse(dataEl.textContent);

    const width = 600;
    const height = 320;
    const nodes = graphData.nodes.map((n) => ({ ...n }));
    const edges = graphData.edges.map((e) => ({ ...e }));

    const svgNS = 'http://www.w3.org/2000/svg';
    const edgeEls = new Map();
    const nodeEls = new Map();

    const edgeGroup = document.createElementNS(svgNS, 'g');
    const nodeGroup = document.createElementNS(svgNS, 'g');
    svg.appendChild(edgeGroup);
    svg.appendChild(nodeGroup);

    for (const e of edges) {
      const line = document.createElementNS(svgNS, 'line');
      line.setAttribute('stroke', 'var(--border)');
      line.setAttribute('stroke-width', '1');
      edgeGroup.appendChild(line);
      edgeEls.set(e, line);
    }

    const colorFor = (kind) =>
      kind === 'page' ? 'var(--accent)' : kind === 'project' ? 'var(--text)' : 'var(--text-dim)';
    const radiusFor = (kind) => (kind === 'page' ? 7 : kind === 'project' ? 5 : 3.5);
    const padding = 24;

    for (const n of nodes) {
      const g = document.createElementNS(svgNS, 'g');
      g.setAttribute('class', 'site-graph-node');
      g.style.cursor = 'pointer';

      const circle = document.createElementNS(svgNS, 'circle');
      const r = radiusFor(n.kind);
      circle.setAttribute('r', String(r));
      circle.setAttribute('fill', colorFor(n.kind));
      circle.style.pointerEvents = 'none';
      g.appendChild(circle);

      const hitArea = document.createElementNS(svgNS, 'circle');
      hitArea.setAttribute('r', '16');
      hitArea.setAttribute('fill', 'transparent');
      hitArea.style.cursor = 'pointer';
      g.appendChild(hitArea);

      const label = document.createElementNS(svgNS, 'text');
      label.setAttribute('font-size', '7.5');
      label.setAttribute('dy', String(-r - 5));
      label.setAttribute('text-anchor', 'middle');
      label.setAttribute('fill', 'var(--text-muted)');
      label.style.pointerEvents = 'none';
      label.textContent = n.label;
      g.appendChild(label);

      nodeGroup.appendChild(g);
      nodeEls.set(n.id, { g, node: n });

      hitArea.addEventListener('click', () => {
        if (n.external) {
          window.open(n.url, '_blank', 'noopener,noreferrer');
        } else {
          window.location.href = n.url;
        }
      });

      hitArea.addEventListener('mouseenter', () => highlight(n.id));
      hitArea.addEventListener('mouseleave', () => unhighlight());

      let dragging = false;
      hitArea.addEventListener('pointerdown', (ev) => {
        dragging = true;
        n.fx = n.x;
        n.fy = n.y;
        hitArea.setPointerCapture(ev.pointerId);
        simulation.alphaTarget(0.3).restart();
      });
      hitArea.addEventListener('pointermove', (ev) => {
        if (!dragging) return;
        const rect = svg.getBoundingClientRect();
        const scaleX = width / rect.width;
        const scaleY = height / rect.height;
        n.fx = Math.max(padding, Math.min(width - padding, (ev.clientX - rect.left) * scaleX));
        n.fy = Math.max(padding, Math.min(height - padding, (ev.clientY - rect.top) * scaleY));
      });
      const stopDrag = () => {
        if (!dragging) return;
        dragging = false;
        simulation.alphaTarget(0);
      };
      hitArea.addEventListener('pointerup', stopDrag);
      hitArea.addEventListener('pointercancel', stopDrag);
    }

    function highlight(id) {
      const connected = new Set([id]);
      for (const e of edges) {
        if (e.source.id === id) connected.add(e.target.id);
        if (e.target.id === id) connected.add(e.source.id);
      }
      for (const [nodeId, { g }] of nodeEls) {
        g.style.opacity = connected.has(nodeId) ? '1' : '0.25';
      }
      for (const [e, line] of edgeEls) {
        line.style.opacity = connected.has(e.source.id) && connected.has(e.target.id) ? '1' : '0.1';
      }
    }

    function unhighlight() {
      for (const [, { g }] of nodeEls) g.style.opacity = '1';
      for (const [, line] of edgeEls) line.style.opacity = '1';
    }

    const simulation = forceSimulation(nodes)
      .force('link', forceLink(edges).id((d) => d.id).distance(75))
      .force('charge', forceManyBody().strength(-160))
      .force('center', forceCenter(width / 2, height / 2))
      .force('collide', forceCollide(28))
      .on('tick', () => {
        for (const n of nodes) {
          n.x = Math.max(padding, Math.min(width - padding, n.x));
          n.y = Math.max(padding, Math.min(height - padding, n.y));
        }
        for (const e of edges) {
          const line = edgeEls.get(e);
          line.setAttribute('x1', e.source.x);
          line.setAttribute('y1', e.source.y);
          line.setAttribute('x2', e.target.x);
          line.setAttribute('y2', e.target.y);
        }
        for (const [, { g, node }] of nodeEls) {
          g.setAttribute('transform', `translate(${node.x}, ${node.y})`);
        }
      });
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(initSiteGraph, { timeout: 2000 });
  } else {
    setTimeout(initSiteGraph, 200);
  }
</script>
