---
import '../styles/global.css';
import { SITE, NAV } from '../lib/site';
import { fetchDocsRepos } from '../lib/github';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "Hardware engineer building at the intersection of hardware and software." } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.role}`;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const docsRepos = await fetchDocsRepos();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const theme = saved ?? 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col md:flex-row">
      <aside class="w-full flex-shrink-0 border-b border-[var(--border)] bg-[var(--bg-sidebar)] md:sticky md:top-0 md:h-screen md:w-64 md:overflow-y-auto md:border-b-0 md:border-r">
        <div class="flex items-center justify-between gap-2 border-b border-[var(--border)] px-4 py-5 md:border-b">
          <a href="/" class="font-display text-[15px] font-semibold text-[var(--white)] hover:text-[var(--accent)] transition-colors">
            {SITE.name}
          </a>
          <div class="flex items-center gap-2">
            <button
              id="theme-toggle"
              aria-label="Toggle theme"
              class="flex h-[30px] w-[30px] items-center justify-center rounded-md border border-[var(--border)] bg-[var(--bg-card)] text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
            >
              <span id="theme-icon">☾</span>
            </button>
            <button
              id="nav-toggle"
              aria-label="Toggle navigation"
              aria-expanded="false"
              class="flex h-[30px] w-[30px] items-center justify-center rounded-md border border-[var(--border)] bg-[var(--bg-card)] text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors md:hidden"
            >
              <span id="nav-icon">☰</span>
            </button>
          </div>
        </div>
        <div id="nav-panel" class="hidden md:block">
          <nav class="p-2">
            {NAV.map((item) => {
              const active = currentPath === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    "font-mono block rounded-md px-3 py-1.5 text-[11.5px] transition-colors",
                    active
                      ? "bg-[var(--accent-dim)] text-[var(--accent)]"
                      : "text-[var(--text-muted)] hover:bg-[var(--bg-hover)] hover:text-[var(--text)]",
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>
          {docsRepos.length > 0 && (
            <div class="border-t border-[var(--border)] p-2">
              <p class="px-3 pb-1 pt-2 font-mono text-[10px] uppercase tracking-wide text-[var(--text-dim)]">
                Documentation
              </p>
              {docsRepos.map((repo) => (
                <a
                  href={repo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono block rounded-md px-3 py-1.5 text-[11.5px] text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-hover)] hover:text-[var(--text)]"
                >
                  {repo.name}
                </a>
              ))}
            </div>
          )}
          <div class="flex flex-wrap gap-3 border-t border-[var(--border)] px-4 py-3 md:mt-auto">
            <span class="font-mono text-[10px] text-[var(--text-dim)]">{SITE.location}</span>
          </div>
        </div>
      </aside>
      <main class="max-w-[840px] flex-1 px-5 py-10 md:px-18 md:py-14">
        <slot />
      </main>
    </div>
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      const icon = document.getElementById('theme-icon');
      function sync() {
        const t = document.documentElement.getAttribute('data-theme');
        if (icon) icon.textContent = t === 'dark' ? '☾' : '☀';
      }
      sync();
      btn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        sync();
      });

      const navBtn = document.getElementById('nav-toggle');
      const navIcon = document.getElementById('nav-icon');
      const navPanel = document.getElementById('nav-panel');
      navBtn?.addEventListener('click', () => {
        const isOpen = navPanel?.classList.toggle('hidden') === false;
        navBtn.setAttribute('aria-expanded', String(isOpen));
        if (navIcon) navIcon.textContent = isOpen ? '✕' : '☰';
      });
    </script>
  </body>
</html>
