---
import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/Tag.astro';
import { getUnifiedProjects } from '../../lib/projects';

const projects = await getUnifiedProjects();
const pinned = projects.filter((p) => p.pinned);
const rest = projects.filter((p) => !p.pinned);
---

<Layout title="Projects">
  <div class="eyebrow font-mono text-[10px] uppercase tracking-[3px] text-[var(--accent)] mb-4">// projects</div>
  <h1 class="font-display text-[clamp(30px,5vw,52px)] font-medium leading-tight tracking-tight text-[var(--white)] mb-8">
    Projects
  </h1>

  {pinned.length > 0 && (
    <div class="mb-10">
      <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--text-dim)] mb-3">Pinned</p>
      <div class="flex flex-col">
        {pinned.map((project) => (
          <a
            href={project.hasDetailPage ? `/projects/${project.id}/` : project.url}
            target={project.hasDetailPage ? undefined : '_blank'}
            rel={project.hasDetailPage ? undefined : 'noreferrer'}
            class="grid grid-cols-[28px_1fr_auto] items-baseline gap-4 rounded-md border-b border-[var(--border-light)] px-2.5 py-4 transition-colors hover:bg-[var(--bg-hover)]"
          >
            <span class="text-center text-[16px] text-[var(--accent)]">{project.icon}</span>
            <div>
              <div class="font-display text-[17px] font-medium text-[var(--white)] mb-1">{project.title}</div>
              <p class="text-[13px] leading-[1.65] text-[var(--text-muted)] font-light">{project.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {project.tags.map((tag) => <Tag label={tag} />)}
              </div>
            </div>
            <span class="font-mono self-center text-[12px] text-[var(--text-dim)]">→</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="flex flex-col">
    {rest.map((project) => (
      <a
        href={project.hasDetailPage ? `/projects/${project.id}/` : project.url}
        target={project.hasDetailPage ? undefined : '_blank'}
        rel={project.hasDetailPage ? undefined : 'noreferrer'}
        class="grid grid-cols-[28px_1fr_auto] items-baseline gap-4 rounded-md border-b border-[var(--border-light)] px-2.5 py-4 transition-colors hover:bg-[var(--bg-hover)]"
      >
        <span class="text-center text-[16px] text-[var(--accent)]">{project.icon}</span>
        <div>
          <div class="font-display text-[17px] font-medium text-[var(--white)] mb-1">{project.title}</div>
          <p class="text-[13px] leading-[1.65] text-[var(--text-muted)] font-light">{project.description}</p>
          <div class="flex flex-wrap gap-1.5 mt-2">
            {project.tags.map((tag) => <Tag label={tag} />)}
          </div>
        </div>
        <span class="font-mono self-center text-[12px] text-[var(--text-dim)]">→</span>
      </a>
    ))}
  </div>
</Layout>
