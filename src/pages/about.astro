---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';

const skills = [
  "SystemVerilog", "VHDL", "RISC-V", "Computer Architecture",
  "Python", "C", "C++", "Linux",
  "Git", "FPGA", "Signal Processing", "Electrical Engineering",
];
---

<Layout title="About">
  <div class="eyebrow font-mono text-[10px] uppercase tracking-[3px] text-[var(--accent)] mb-4">// about</div>
  <div class="flex h-[110px] w-[110px] items-center justify-center rounded-full border-2 border-[var(--border)] bg-[var(--bg-card)] font-display text-[34px] tracking-tighter text-[var(--accent)] mb-7">
    {SITE.initials}
  </div>
  <h1 class="font-display text-[clamp(30px,5vw,52px)] font-medium leading-tight tracking-tight text-[var(--white)] mb-5">
    Manas<br />Tanneeru
  </h1>

  <p class="text-[16px] leading-[1.88] text-[var(--text-muted)] font-light mb-4">
    I'm a Hardware Engineer based out of Portland, Oregon, with a focus on computer
    architecture and digital design. I enjoy working at the intersection of hardware and
    software — building systems where the two meet cleanly.
  </p>
  <p class="text-[16px] leading-[1.88] text-[var(--text-muted)] font-light mb-4">
    I graduated with a <strong class="font-medium text-inherit">Master's in Electrical and
    Computer Engineering</strong> and a <strong class="font-medium text-inherit">Bachelor's
    in Computer Engineering</strong> from{" "}
    <a href="https://engineering.purdue.edu/ECE" target="_blank" rel="noreferrer" class="text-[var(--accent-text)] underline decoration-[var(--accent-dim)] underline-offset-[3px] hover:decoration-[var(--accent)]">Purdue University</a>.
  </p>
  <p class="text-[16px] leading-[1.88] text-[var(--text-muted)] font-light mb-4">
    My current focus is on scalable processor design — specifically building a modular
    RISC-V core that supports both in-order and out-of-order execution across single and
    multicore configurations.
  </p>

  <hr class="border-t border-[var(--border)] my-10" />
  <h2 class="font-display text-[21px] font-medium tracking-tight text-[var(--white)] mb-3.5">Technologies &amp; Tools</h2>
  <div class="flex flex-wrap gap-2 mt-4">
    {skills.map((s) => (
      <span class="font-mono text-[11px] rounded-full border border-[var(--border)] px-3 py-1 text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-colors">{s}</span>
    ))}
  </div>

  <hr class="border-t border-[var(--border)] my-10" />
  <h2 class="font-display text-[21px] font-medium tracking-tight text-[var(--white)] mb-3.5">Get in touch</h2>
  <p class="text-[16px] leading-[1.88] text-[var(--text-muted)] font-light mb-4">
    If you have questions or are curious about my work, feel free to reach out.
  </p>
  <div class="flex flex-wrap gap-3 mt-6">
    <a href={`mailto:${SITE.email}`} class="font-mono text-[11px] tracking-wide flex items-center gap-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-4.5 py-2.5 text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-colors">✉ Email</a>
    <a href={SITE.linkedin} target="_blank" rel="noreferrer" class="font-mono text-[11px] tracking-wide flex items-center gap-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-4.5 py-2.5 text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-colors">LinkedIn ↗</a>
    <a href={SITE.github} target="_blank" rel="noreferrer" class="font-mono text-[11px] tracking-wide flex items-center gap-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-4.5 py-2.5 text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-colors">GitHub ↗</a>
  </div>
</Layout>
