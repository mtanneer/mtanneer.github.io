---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
import { fetchGithubStats, fetchContributionCalendar, fetchPinnedRepos } from '../lib/github';

const stats = await fetchGithubStats();
const calendar = await fetchContributionCalendar();
const pinnedRepos = await fetchPinnedRepos();
const relativeTime = (iso: string) => {
  const days = Math.floor((Date.now() - new Date(iso).valueOf()) / 86_400_000);
  if (days === 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  return `${months}mo ago`;
};
---

<Layout>
  <div class="eyebrow font-mono text-[10px] uppercase tracking-[3px] text-[var(--accent)] mb-4">// home</div>
  <h1 class="font-display text-[clamp(30px,5vw,52px)] font-medium leading-tight tracking-tight text-[var(--white)] mb-5">
    {SITE.name}
  </h1>
  <p class="font-display italic text-[17px] text-[var(--text-muted)] mb-6">
    {SITE.role} · {SITE.location}
  </p>
  <p class="text-[16px] leading-[1.88] text-[var(--text-muted)] font-light">
    Building at the intersection of hardware and software — computer architecture,
    digital design, and the occasional side project.
  </p>
  <div class="flex flex-wrap gap-2.5 mt-7">
    <a href="/projects/" class="font-mono text-[12px] rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-3.5 py-2 text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-colors">Projects →</a>
    <a href="/about/" class="font-mono text-[12px] rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-3.5 py-2 text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-colors">About →</a>
  </div>

  <hr class="border-t border-[var(--border)] my-10" />
  <h2 class="font-display text-[21px] font-medium tracking-tight text-[var(--white)] mb-1">GitHub activity</h2>
  <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--text-dim)] mb-5">
    {stats.publicRepos} public repos · {stats.followers} followers
  </p>

  {calendar && (
    <div class="mb-8 overflow-x-auto">
      <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--text-dim)] mb-2">
        {calendar.totalContributions} contributions in the last year
      </p>
      <svg
        width={calendar.weeks.length * 13 - 3}
        height={7 * 13 - 3}
        role="img"
        aria-label={`${calendar.totalContributions} contributions in the last year`}
      >
        {calendar.weeks.map((week, wi) =>
          week.map((day, di) => (
            <rect x={wi * 13} y={di * 13} width="10" height="10" rx="2" class={`lvl${day.level}`} />
          ))
        )}
      </svg>
    </div>
  )}

  <div class="flex flex-col">
    {pinnedRepos.map((repo) => (
      <a
        href={repo.url}
        target="_blank"
        rel="noreferrer"
        class="flex items-baseline justify-between gap-4 border-b border-[var(--border-light)] px-2 py-3 transition-colors hover:bg-[var(--bg-hover)]"
      >
        <div>
          <span class="font-display text-[15px] text-[var(--white)]">{repo.name}</span>
          {repo.language && (
            <span class="font-mono ml-2 text-[10px] text-[var(--text-dim)]">{repo.language}</span>
          )}
        </div>
        <span class="font-mono flex-shrink-0 text-[10px] text-[var(--text-dim)]">{relativeTime(repo.updatedAt)}</span>
      </a>
    ))}
  </div>

</Layout>
